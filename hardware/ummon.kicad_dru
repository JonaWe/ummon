(version 1)
# JLCPCB 4-layer, 1 oz outer / 0.5 oz inner, Standard PCBA
# Stand: 2026-07 (jlcpcb.com/capabilities/pcb-capabilities)
# Basiswerte (min. Leiterbahn 0.1mm, Clearance 0.1mm, Via 0.45/0.2mm,
# Kupfer-zu-Kante 0.3mm, Maskensteg 0.1mm) im Board Setup eintragen,
# diese Datei ergaenzt nur, was dort nicht abbildbar ist.

# --- Bohrungsabstaende ---------------------------------------------

# Via-zu-Via (auch gleiche Netze): Bohrer-zu-Bohrer 0.2mm
(rule "via hole to via hole"
	(constraint hole_to_hole (min 0.2mm))
	(condition "A.Type == 'via' && B.Type == 'via'"))

# THT-Pad-Bohrungen untereinander: 0.45mm
(rule "pad hole to pad hole"
	(constraint hole_to_hole (min 0.45mm))
	(condition "A.Type == 'pad' && B.Type == 'pad'"))

# --- Bohrung zu Leiterbahn -----------------------------------------

# PTH-Bohrung zu fremder Leiterbahn: min 0.28, empfohlen 0.35
(rule "PTH hole to track"
	(constraint hole_clearance (min 0.33mm))
	(condition "A.Type == 'pad' && A.isPlated() && B.Type == 'track'"))

# NPTH zu Leiterbahn: 0.2mm
(rule "NPTH hole to track"
	(constraint hole_clearance (min 0.2mm))
	(condition "A.Type == 'pad' && !A.isPlated() && B.Type == 'track'"))

# Via-Bohrung zu fremder Leiterbahn: 0.2mm
(rule "via hole to track"
	(constraint hole_clearance (min 0.2mm))
	(condition "A.Type == 'via' && B.Type == 'track'"))

# --- Bohrungsgroessen ----------------------------------------------

# NPTH min. 0.5mm
(rule "NPTH minimum size"
	(constraint hole_size (min 0.5mm))
	(condition "A.Type == 'pad' && !A.isPlated()"))

# PTH-Bereich (>=6.3mm wird gefraest)
(rule "PTH size range"
	(constraint hole_size (min 0.2mm) (max 6.3mm))
	(condition "A.Type == 'pad' && A.isPlated()"))

# Empfohlene PTH-Groesse gegen Maskenreste in der Bohrung
(rule "PTH recommended minimum"
	(severity warning)
	(constraint hole_size (min 0.5mm))
	(condition "A.Type == 'pad' && A.isPlated()"))

# --- Ringbreite -----------------------------------------------------

# Multilayer 1oz: empfohlen 0.20mm, absolutes Minimum 0.15mm
(rule "PTH annular ring"
	(constraint annular_width (min 0.2mm))
	(condition "A.Type == 'pad' && A.isPlated()"))

(rule "via annular ring"
	(constraint annular_width (min 0.125mm))
	(condition "A.Type == 'via'"))

# --- Innenlagen -----------------------------------------------------

# Via-Bohrung zu Kupferflaechen auf Innenlagen: 0.2mm
(rule "inner layer via to copper"
	(constraint hole_clearance (min 0.2mm))
	(layer inner)
	(condition "A.Type == 'via' && B.Type == 'zone'"))

# PTH-Bohrung zu Kupfer auf Innenlagen: 0.3mm
(rule "inner layer PTH to copper"
	(constraint hole_clearance (min 0.3mm))
	(layer inner)
	(condition "A.Type == 'pad' && A.isPlated() && B.Type == 'zone'"))

# --- Silkscreen -----------------------------------------------------

(rule "silkscreen text minimum"
	(constraint text_thickness (min 0.15mm))
	(constraint text_height (min 1mm))
	(layer "?.Silkscreen"))

(rule "pad to silkscreen"
	(constraint silk_clearance (min 0.15mm))
	(condition "A.Type == 'pad' && (B.Type == 'text' || B.Type == 'graphic')"))
